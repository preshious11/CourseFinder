# --- required ---
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- source 1: official Udemy Affiliate API (permanently free courses) ---
# Requires an approved affiliate account:
# https://www.udemy.com/affiliate/  then  https://www.udemy.com/user/edit-api-clients/
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

# --- source 0: tutorialbar (no credentials needed, highest yield) ---
# The default source - works out of the box, ~90 live courses per poll.
# Leave TUTORIALBAR_CATEGORIES blank to use the built-in category list.
TUTORIALBAR=true
TUTORIALBAR_CATEGORIES=

# --- source 2: coupon feeds (100%-off deals) ---
# Comma-separated RSS/Atom URLs from aggregators you're allowed to use.
# Note: many aggregators block non-browser traffic or only link to their own
# landing pages, in which case they contribute nothing. Check the logs.
COUPON_FEEDS=https://www.reddit.com/r/udemyfreebies/.rss,https://freebiesglobal.com/feed

# --- tuning ---
DB_PATH=bot.db
# Seconds between source checks. Instant subscribers are notified as soon as a
# check finds a deal — this only controls how quickly the bot *notices* one.
# Lower = fresher deals, more requests to the sources. 600 (10 min) is a
# reasonable floor; much below that risks rate-limiting from tutorialbar/RSS.
POLL_INTERVAL=3600
MAX_PER_CYCLE=10       # max courses announced per check
LANGUAGE=en
ADMIN_CHAT_ID=

# --- webhook mode (set WEBHOOK_URL to enable) ---
# When set, the bot receives updates via webhook instead of long-polling.
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8443
WEBHOOK_URL=
WEBHOOK_PORT=8443

# --- health check endpoint (set HEALTH_PORT to enable) ---
# Serves GET /healthz with JSON stats. Disabled when unset or 0.
HEALTH_PORT=

# --- multi-platform /search ---
# Which platforms /search queries, in addition to the Udemy sources above.
# All are public endpoints needing no credentials; set any to false to skip it.
SEARCH_MIT=true            # MIT Open Learning (OCW + MITx) - real search API
SEARCH_COURSERA=true       # public catalogue, matched locally
SEARCH_EDX=true            # public course list, matched locally
SEARCH_FREECODECAMP=true   # published tutorial RSS feed

# Coursera and edX expose no working server-side search, so the bot scans this
# many catalogue pages (100 entries each) per query and matches locally.
# Higher = better recall, slower searches.
SEARCH_CATALOGUE_PAGES=5
SEARCH_TIMEOUT=25          # seconds before a single platform is given up on

# Not implemented - no permitted programmatic access exists:
#   Class Central (no public API), Khan Academy (open API returns 410 Gone),
#   FutureLearn (no public API), Pluralsight and LinkedIn Learning (partner
#   APIs, credentials are not self-serve). Add them here if you obtain access.
