# --- required ---
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN= 8857254752:AAGYC_Zlpitl2l88kYJrLX03M9M8JEF-R-Y

# --- source 1: official Udemy Affiliate API (permanently free courses) ---
# Requires an approved affiliate account:
# https://www.udemy.com/affiliate/  then  https://www.udemy.com/user/edit-api-clients/
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

# --- source 0: tutorialbar (no credentials needed, highest yield) ---
# This is what makes the bot work out of the box: ~90 live courses per poll.
# Set to false to disable. Leave categories blank to use the built-in list.
TUTORIALBAR=true
TUTORIALBAR_CATEGORIES=

# --- source 2: coupon feeds (100%-off deals) ---
# Comma-separated RSS/Atom URLs from aggregators you're allowed to use.
# These two were verified to actually serve direct udemy.com/course/ links.
# Many popular aggregators (onlinecourses.ooo, jucktion, couponscorpion,
# discudemy, tutorialbar) either block non-browser traffic or only link to
# their own landing pages, so they yield nothing here.
COUPON_FEEDS=https://www.reddit.com/r/udemyfreebies/.rss,https://freebiesglobal.com/feed

# --- tuning ---
DB_PATH=bot.db
POLL_INTERVAL=3600     # seconds between checks
MAX_PER_CYCLE=10       # max courses announced per check
LANGUAGE=en
ADMIN_CHAT_ID=
